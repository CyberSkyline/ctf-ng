{
  "name": "ctf-ng",
  "version": "1.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberSkyline/ctf-ng.git"
  },
  "license": "GPL-3.0",
  "author": "Cyber Skyline",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "prod-start": "yarn build && ENV_FILE=.env.prod docker compose up ctfd --build",
    "outdated": "yarn upgrade-interactive",
    "build": "cd ./frontend && vite build",
    "lint": "cd ./frontend && yarn lint",
    "start": "ENV_FILE=.env.dev docker compose up ctfd --build",
    "stop": "docker compose down",
    "reload": "docker exec -it ng-ctfd supervisorctl restart ctfd",
    "restart": "docker exec -it ng-ctfd supervisorctl restart ctfd",
    "restart-nginx": "docker exec -it ng-nginx service nginx restart",
    "logs-nginx": "docker compose logs -f nginx",
    "logs-vite": "docker compose logs -f vite",
    "logs-ctfd": "docker compose logs -f ctfd",
    "nuke": "rm -rf ./node_modules && yarn install"
  },
  "devDependencies": {
    "@yarnpkg/plugin-interactive-tools": "^4.0.3"
  },
  "packageManager": "yarn@3.7.0"
}
