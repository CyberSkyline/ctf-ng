{
  "name": "ctf-ng",
  "version": "1.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberSkyline/ctf-ng.git"
  },
  "license": "GPL-3.0",
  "author": "Cyber Skyline",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup-ctfd": ".yarn-scripts/default_ctfd_setup.sh",
    "populate-data": ".yarn-scripts/populate_data.sh",
    "lint": "yarn workspaces foreach --all run lint",
    "test": "yarn workspaces foreach --all run test",
    "outdated": "yarn upgrade-interactive",
    "build": "cd ./frontend && vite build",
    "start-prod": "yarn build && ENV_FILE=.env.prod docker compose -f docker-compose.prod.yaml up ctfd --build",
    "start-staging": "yarn build && ENV_FILE=.env.staging docker compose -f docker-compose.prod.yaml up ctfd --build",
    "start": "ENV_FILE=.env.dev docker compose -f docker-compose.yaml up ctfd --build",
    "stop": "docker compose down",
    "reload": "docker exec -it ng-ctfd supervisorctl restart ctfd",
    "restart": "docker exec -it ng-ctfd supervisorctl restart ctfd",
    "logs-nginx": "docker logs --tail=1000 ng-nginx -f",
    "logs-ctfd": "docker logs --tail=1000 ng-ctfd -f",
    "logs-vite": "docker logs --tail=1000 ng-vite -f",
    "errors-ctfd": "docker exec -it ng-ctfd cat /var/log/supervisor/ctfd.error.log",
    "nuke": "rm -rf ./node_modules && yarn install",
    "chall-check": "backend/venv/bin/chall-check",
    "support-test": "docker compose -f websockets/docker-compose.yml.support up --build",
    "support-down": "docker compose -f websockets/docker-compose.yml.support down",
    "sql": "docker exec -i -t ng-db mariadb --user=ctfd --password=ctfd ctfd"
  },
  "packageManager": "yarn@4.9.2+sha512.1fc009bc09d13cfd0e19efa44cbfc2b9cf6ca61482725eb35bbc5e257e093ebf4130db6dfe15d604ff4b79efd8e1e8e99b25fa7d0a6197c9f9826358d4d65c3c"
}
