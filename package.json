{
  "name": "ctf-ng",
  "version": "1.0.0",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberSkyline/ctf-ng.git"
  },
  "license": "GPL-3.0",
  "author": "Cyber Skyline",
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": "10.17.x"
  },
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "exec-service"
  ],
  "scripts": {
    "aws-login": ".bin/aws_login.sh $1",
    "sync-env": ".bin/sync_env.sh",
    "setup-ctfd": ".bin/default_ctfd_setup.sh",
    "populate-data": ".bin/populate_data.sh",
    "populate-load-test": ".bin/populate_data.sh true",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "cd ./frontend && vite build",
    "start-prod": "pnpm build && ENV_FILE=.env.prod docker compose -f docker-compose.prod.yaml up --build",
    "start-staging": "pnpm build && ENV_FILE=.env.staging docker compose -f docker-compose.prod.yaml up --build",
    "start": "USE_MINIO=true ENV_FILE=.env.dev docker compose -f docker-compose.yaml up --build",
    "start-aws": "USE_MINIO=false ENV_FILE=.env.dev docker compose -f docker-compose.yaml up --build",
    "stop": "docker compose down",
    "reload": "docker exec -it ng-ctfd supervisorctl restart ctfd",
    "restart": "docker exec -it ng-ctfd supervisorctl restart ctfd",
    "logs-nginx": "docker logs --tail=1000 ng-nginx -f",
    "logs-ctfd": "docker logs --tail=1000 ng-ctfd -f",
    "logs-vite": "docker logs --tail=1000 ng-vite -f",
    "errors-ctfd": "docker exec -it ng-ctfd cat /var/log/supervisor/ctfd.error.log",
    "nuke": "rm -rf ./node_modules && pnpm install",
    "chall-check": "backend/venv/bin/chall-check",
    "sql": "docker exec -i -t ng-db mariadb --user=ctfd --password=ctfd ctfd",
    "postinstall": ".bin/sync_env.sh",
    "swarm-build:ctfd": "docker build -t ctfd-ng:latest -f ./dockerfiles/ctfd.Dockerfile .",
    "swarm-build:vite": "docker build -t vite-ng:latest -f ./dockerfiles/vite.Dockerfile .",
    "swarm-build:all": "pnpm swarm-build:ctfd && pnpm swarm-build:vite",
    "swarm-start": "pnpm swarm-deploy",
    "swarm-deploy": "pnpm build && pnpm swarm-build:all && ENV_FILE=.env.prod docker stack deploy -c docker-compose.prod.yaml ctf-ng",
    "swarm-remove": "docker stack rm ctf-ng",
    "swarm-services": "docker stack services ctf-ng",
    "swarm-ps": "docker stack ps ctf-ng",
    "swarm-logs": "docker service logs --tail=100 -f ctf-ng_ctfd",
    "swarm-logs-nginx": "docker service logs --tail=100 -f ctf-ng_nginx",
    "swarm-logs-vite": "docker service logs --tail=100 -f ctf-ng_vite",
    "swarm-update": "pnpm build && pnpm swarm-build:all && docker service update --force ctf-ng_ctfd",
    "minio": "docker compose up -d minio && bash ./setup-minio.sh"
  },
  "packageManager": "pnpm@10.17.1"
}
