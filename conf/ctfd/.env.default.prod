ENVIRONMENT=PRODUCTION

DATABASE_URL=mysql+pymysql://RDS_USERNAME:RDS_PASSWORD@RDS_ENDPOINT:3306/
REDIS_URL=redis://cache:6379
DEBUG=false
LOG_FOLDER=/var/log/CTFd
STATIC_BUILD_PATH=/dist/
ROUTE_PREFIX=/ctf
SWAGGER_UI=false
LOG_LEVEL=WARNING
UPLOAD_FOLDER=/var/uploads
WORKERS=1
ACCESS_LOG=-
ERROR_LOG=-
SECRET_KEY=7983c810e4f49cf18e67e0da2cb1eff35c93466b9325b1c4eee3125e4003c795

# Flask settings
# NOTE: FLASK_ENV is deprecated in the latest version of Flask, but CTFd uses an older version
FLASK_ENV=production
FLASK_RUN_PORT=-

# Docker
DOCKER_HOST=127.0.0.1:2376
CONTAINER_REGISTRY=-
CONTAINER_REGISTRY_USER=-
CONTAINER_REGISTRY_PASSWORD=-

# OAuth
OKTA_CLIENT_ID=-
OKTA_CLIENT_SECRET=-
OKTA_DOMAIN=-
SERVER_DOMAIN=-
# External URL that /ng/authenticate/okta/register redirects to,
# used by the login page's Create SSO Account button.
SSO_REGISTRATION_URL=

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=-
AWS_SECRET_ACCESS_KEY=-
AWS_S3_BUCKET_NAME=-
AWS_SES_FROM_EMAIL=-
ADMIN_SUPPORT_INBOX_EMAILS=-

# Sentry logging
SENTRY_DSN=-