DATABASE_URL=mysql+pymysql://ctfd:ctfd@db/ctfd # Must be set as a secret in production
REDIS_URL=redis://cache:6379 # Must be set as a secret in production
DEBUG=true # must be set to false in production
LOG_FOLDER=/var/log/CTFd # Must point to the nfs mount in production
STATIC_BUILD_PATH=/static/ # Must point to the CDN in production
ROUTE_PREFIX=""
SWAGGER_UI=true
LOG_LEVEL=DEBUG  # DEBUG for development | INFO/WARNING for production.     
UPLOAD_FOLDER=/var/uploads
WORKERS=1
ACCESS_LOG=-
ERROR_LOG=-
SECRET_KEY=7983c810e4f49cf18e67e0da2cb1eff35c93466b9325b1c4eee3125e4003c795 # Must be set as a secret in production

# Flask settings
# NOTE: FLASK_ENV is deprecated in the latest version of Flask, but CTFd uses an older version
FLASK_ENV=development
FLASK_RUN_PORT=4000

# Docker
DOCKER_HOST=127.0.0.1:2376
CONTAINER_REGISTRY=-
CONTAINER_REGISTRY_USER=""
CONTAINER_REGISTRY_PASSWORD=""

# OAuth
OKTA_CLIENT_ID=-
OKTA_CLIENT_SECRET=-
OKTA_DOMAIN=-
SERVER_DOMAIN=-
# External URL that /ng/authenticate/okta/register redirects to,
# used by the login page's Create SSO Account button.
SSO_REGISTRATION_URL=

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=-
AWS_SECRET_ACCESS_KEY=-
AWS_S3_BUCKET_NAME=-
AWS_SES_FROM_EMAIL=-
ADMIN_SUPPORT_INBOX_EMAILS=-

# Sentry logging
SENTRY_DSN=-