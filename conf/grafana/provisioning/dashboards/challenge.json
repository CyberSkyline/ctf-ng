          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH \r\n-- 1. Total of all submissions BEFORE the dashboard start time\r\nstarting_balance AS (\r\n    SELECT COUNT(*) as base_count\r\n    FROM ng_attempts\r\n    WHERE timestamp < $__timeFrom() and challenge_id = $challenge \r\n),\r\n-- 2. New submissions within the dashboard window\r\ndaily_buckets AS (\r\n    SELECT \r\n        $__timeGroup(timestamp, $__interval) AS time_bucket,\r\n        COUNT(*) AS bucket_count\r\n    FROM ng_attempts\r\n    WHERE $__timeFilter(timestamp) and challenge_id = $challenge\r\n    GROUP BY 1\r\n),\r\n-- 3. Calculate running total starting from the base count\r\nrunning_total_series AS (\r\n    SELECT \r\n        FROM_UNIXTIME(time_bucket) AS time,\r\n        (SELECT base_count FROM starting_balance) + \r\n         SUM(bucket_count) OVER (ORDER BY time_bucket ROWS UNBOUNDED PRECEDING) AS total\r\n    FROM daily_buckets\r\n)\r\n-- 4. Combine: Start Point + Main Series + End Point\r\nSELECT $__timeFrom() AS time, (SELECT base_count FROM starting_balance) AS total\r\nUNION ALL\r\nSELECT time, total FROM running_total_series\r\nUNION ALL\r\nSELECT \r\n    $__timeTo() AS time, \r\n    COALESCE(MAX(total), (SELECT base_count FROM starting_balance)) AS total \r\nFROM running_total_series\r\nORDER BY time",
          "refId": "total",
          "sql": {
            "columns": [
              {
                "name": "$__timeGroup",
                "parameters": [
                  {
                    "name": "timestamp",
                    "type": "functionParameter"
                  },
                  {
                    "name": "$__interval",
                    "type": "functionParameter"
                  },
                  {
                    "name": "0",
                    "type": "functionParameter"
                  }
                ],
                "type": "function"
              },
              {
                "name": "COUNT",
                "parameters": [
                  {
                    "name": "timestamp",
                    "type": "functionParameter"
                  }
                ],
                "type": "function"
              }
            ],
            "groupBy": [],
            "limit": 50,
            "whereJsonTree": {
              "children1": [
                {
                  "id": "bba98ba9-cdef-4012-b456-719b8fedef88",
                  "properties": {
                    "fieldSrc": "field",
                    "value": [],
                    "valueSrc": []
                  },
                  "type": "rule"
                }
              ],
              "id": "b8b88aa9-0123-4456-b89a-b19b8fe5dd5f",
              "type": "group"
            }
          },
          "table": "ng_attempts"
        },
        {
          "dataset": "ctfd",
          "datasource": {
            "type": "mysql",
            "uid": "PC4AF0AAB7519420B"
          },
          "editorMode": "code",
          "format": "time_series",
          "hide": false,
          "rawQuery": true,
          "rawSql": "WITH \r\n-- 1. Total of all submissions BEFORE the dashboard start time\r\nstarting_balance AS (\r\n    SELECT COUNT(*) as base_count\r\n    FROM ng_attempts\r\n    WHERE is_correct = 1 and challenge_id = $challenge\r\n    AND timestamp < $__timeFrom()\r\n),\r\n-- 2. New submissions within the dashboard window\r\ndaily_buckets AS (\r\n    SELECT \r\n        $__timeGroup(timestamp, $__interval) AS time_bucket,\r\n        COUNT(*) AS bucket_count\r\n    FROM ng_attempts\r\n    WHERE is_correct = 1 and challenge_id = $challenge and  $__timeFilter(timestamp)\r\n    GROUP BY 1\r\n),\r\n-- 3. Calculate running total starting from the base count\r\nrunning_total_series AS (\r\n    SELECT \r\n        FROM_UNIXTIME(time_bucket) AS time,\r\n        (SELECT base_count FROM starting_balance) + \r\n         SUM(bucket_count) OVER (ORDER BY time_bucket ROWS UNBOUNDED PRECEDING) AS correct\r\n    FROM daily_buckets\r\n)\r\n-- 4. Combine: Start Point + Main Series + End Point\r\nSELECT $__timeFrom() AS time, (SELECT base_count FROM starting_balance) AS correct\r\nUNION ALL\r\nSELECT time, correct FROM running_total_series\r\nUNION ALL\r\nSELECT \r\n    $__timeTo() AS time, \r\n    COALESCE(MAX(correct), (SELECT base_count FROM starting_balance)) AS correct \r\nFROM running_total_series\r\nORDER BY time",
          "refId": "correct",
          "sql": {
