          "rawQuery": true,
          "rawSql": "SELECT\r\n  name AS user,\r\n  JSON_EXTRACT(feedback_data, \"$.difficulty\") AS difficulty,\r\n  JSON_EXTRACT(feedback_data, \"$.quality\") AS quality,\r\n  JSON_UNQUOTE(JSON_EXTRACT(feedback_data, \"$.what_liked\")) AS liked,\r\n  JSON_UNQUOTE(JSON_EXTRACT(feedback_data, \"$.how_to_improve\")) AS improve,\r\n  updated_at\r\nFROM\r\n  ng_feedback\r\n  LEFT JOIN users ON ng_feedback.user_id = users.id\r\nWHERE\r\n  challenge_id = $challenge",
          "refId": "A",
