# These values work for local development. Production deployments will require changes.

# -----
# PATHS
# -----
# The public-facing domain from where grafana is served.
GF_SERVER_DOMAIN=localhost

# The public-facing URL where grafana will be accessible.
# This is used for redirects, shared dashboard URLs, among other things.
# *Path must match configured nginx location for grafana.*
# If nginx is performing TLS termination, this should be https instead of http.
GF_SERVER_ROOT_URL=http://%(domain)s/admin/grafana/

# -------------------
# DATABASE CONNECTION
# -------------------
SQL_HOST=db:3306
SQL_DB=ctfd

# In production environments, the db should use a separate reader user to ensure that grafana cannot modify or drop data.
# See https://grafana.com/docs/grafana/latest/datasources/mysql/configuration/#before-you-begin
SQL_USER=ctfd
SQL_PASSWORD=ctfd

# -----------------
# ADMIN CREDENTIALS
# -----------------
# Credentials for the grafana admin account used to modify dashboards.
# Note that these only apply on first start - use the grafana UI instead to update the password afterwards.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ctfng_password # CHANGE ME!
