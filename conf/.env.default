PYTHONPATH=/home/ubuntu/ctf-ng/external/CTFd

# AWS
AWS_ACCESS_KEY_ID=-
AWS_SECRET_ACCESS_KEY=-
AWS_MFA_ARN=-
AWS_ECR_URI=-

# AWS SES Email Configuration (for support ticket notifications)
# Leave empty to disable email notifications
AWS_SES_ACCESS_KEY_ID=-
AWS_SES_SECRET_ACCESS_KEY=-
AWS_SES_REGION=us-east-2
AWS_SES_FROM_EMAIL=-
# Comma-separated list of team inbox emails to receive notifications
SUPPORT_TEAM_INBOX_EMAILS=-
