PYTHONPATH=/home/ubuntu/ctf-ng/external/CTFd

# AWS
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=-
AWS_SECRET_ACCESS_KEY=-
AWS_MFA_ARN=-
AWS_ECR_URI=-
SERVER_DOMAIN=-

# SES Configuration
AWS_SES_FROM_EMAIL=-
#AWS_SES_ACCESS_KEY_ID
#AWS_SES_SECRET_ACCESS_KEY
# Comma-separated list of admin inbox email/s 
# to receive email notifications for new unassigned tickets only
ADMIN_SUPPORT_INBOX_EMAILS=-

# S3 Configuration
#AWS_S3_ACCESS_KEY_ID=-
#AWS_S3_SECRET_ACCESS_KEY=-
AWS_S3_BUCKET_NAME=-

# MinIO Configuration
USE_MINIO=true # For switching between aws and minio in dev environment
MINIO_ACCESS_KEY=-
MINIO_SECRET_KEY=-
MINIO_ENDPOINT=-
MINIO_BUCKET=-
