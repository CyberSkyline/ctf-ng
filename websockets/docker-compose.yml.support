services:
  ctfd:
    build:
      context: ../
      dockerfile: ./websockets/ctfd-support.Dockerfile
    container_name: ng-ctfd-support
    user: root
    restart: always
    ports:
      - "8000:8000"
      - "4000:4000"
    env_file:
      - ${ENV_FILE:-../.env.dev}  
    environment:
      - DEBUG=false
      - WORKER_CLASS=geventwebsocket.gunicorn.workers.GeventWebSocketWorker
      - THREADS=100
      - REDIS_URL=redis://cache:6379
    # - WORKERS=2 # in process of getting redis queue working correctly (using flask-socketio memory right now)
    # - SECRET_KEY='thisistheredissecretkeysupport'
    volumes:
      - ../.data/CTFd/logs:/var/log/CTFd
      - ../.data/CTFd/uploads:/var/uploads
      - ../backend/ng:/opt/CTFd/CTFd/plugins/ng/:ro
    depends_on:
      - db
      - cache
      - vite
      - nginx
    networks:
      default:
      internal:
    tty: true
    entrypoint : ["/opt/CTFd/support-entrypoint.sh"]
    command: []

  nginx:
    image: nginx:1.28
    container_name: ng-nginx-support
    restart: always
    volumes:
      - ./support-test.conf:/etc/nginx/nginx.conf:ro
      - ../frontend/dist:/var/www/vite-build:ro
    ports:
      - 80:80
      - 5173:5173

  db:
    image: mariadb:10.11
    container_name: ng-db-support
    restart: always
    environment:
      - MARIADB_ROOT_PASSWORD=ctfd
      - MARIADB_USER=ctfd
      - MARIADB_PASSWORD=ctfd
      - MARIADB_DATABASE=ctfd
      - MARIADB_AUTO_UPGRADE=1
    volumes:
      - ../.data/mysql:/var/lib/mysql
    networks:
        internal:
        default:
    # This command is required to set important mariadb defaults
    command: [mysqld, --character-set-server=utf8mb4, --collation-server=utf8mb4_unicode_ci, --wait_timeout=28800, --log-warnings=0]

  cache:
    image: redis:4
    container_name: ng-redis-support
    restart: always
    volumes:
      - ../.data/redis:/data
    networks:
        internal:

  vite:
    build:
      context: ../
      dockerfile: ./dockerfiles/vite.Dockerfile
    container_name: ng-vite-support
    restart: always
    tty: true
    volumes:
      - ../frontend:/app

networks:
    default:
    internal:
      internal: true
